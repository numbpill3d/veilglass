{
  "manifest_version": 3,
  "name": "veilglass shroud",
  "version": "1.0.0",
  "description": "Client-side fingerprint veil for looking into what the glass found: canvas, WebGL, audio, font, hardware and battery noise, plus WebRTC leak sealing.",
  "permissions": ["scripting", "storage", "privacy", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "veilglass shroud",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "shroud@veilglass",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
